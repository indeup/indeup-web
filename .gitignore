# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local tooling/session state — not part of the site itself
/.claude/

# stray local artifacts
/INDEUP
/9.gif
/verify-*.png

# Playwright
/playwright-report/
/test-results/

# Original uncompressed video sources (kept locally for future re-encodes,
# never deployed — the web-optimized version lives in /public/videos/)
/source-assets/

# Real customer review exports (order numbers, review IDs, raw review text)
# — analysis-only, never meant to be committed or deployed. See
# feedback_public_folder_deploy_exposure memory for why these must never
# end up in /public/ either.
/data/reviews/

# Proprietary CAD source files (STEP/DWG engineering drawings) — confidential
# design IP, analysis-only. Never committed, never deployed to /public/.
/data/cad/

# Internal pricing/option spreadsheets (raw supplier data, base prices per
# size/spec) — this repo is public, and these were caught staged for commit
# by hand once already (2026-08-04). Analysis-only, never meant to be
# committed.
/data/*.xls
/data/*.xlsx
